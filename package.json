{
  "name": "garment-pattern-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based editor for 2D garment sewing patterns (GarmentCode specification JSON).",
  "type": "module",
  "scripts": {
    "start": "uv run --project server python server/dart_server.py --port 8000",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\" \"css/**/*.css\" index.html",
    "start:static": "npx --yes http-server -c-1 -p 8000 ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
